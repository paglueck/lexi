{
  "name": "@lexi/server",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "author": "Patrick Glück",
  "type": "module",
  "exports": {
    ".": "./src/main.ts"
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/main.js --sourcemap --packages=bundle --external:@github/copilot-sdk --banner:js=\"import{createRequire as __lexiCreateRequire}from'node:module';const require=__lexiCreateRequire(import.meta.url);\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@github/copilot-sdk": "^1.0.15",
    "@lexi/shared": "*",
    "@lexi/xliff": "*",
    "fastify": "^5.12.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "vitest": "^5.1.0"
  }
}
